# HAL secrets — copy to ~/.config/hal.env on the Pi and fill in.
# This file (the real ~/.config/hal.env) never belongs in the repo.
#
#   cp scripts/hal.env.example ~/.config/hal.env
#   chmod 600 ~/.config/hal.env
#   $EDITOR ~/.config/hal.env
#
# The anthropic SDK reads ANTHROPIC_API_KEY from the environment; the sidecar
# loads this file at startup. Set a monthly spend limit on the key in the
# Anthropic console as a safety net.

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
