# Copy to ~/.config/s52-wifi.env on the Pi (same user as labwc / kiosk).
# Used by scripts/s52-add-wifi-hotspot.sh when setting autoconnect priorities.
#
# NetworkManager profile names must match `nmcli connection show` (the NAME column).

# Phone hotspot profile name — required when running s52-add-wifi-hotspot.sh:
# S52_HOTSPOT_CON_NAME=my-hotspot-profile

# Home WiFi profile name — required when running s52-add-wifi-hotspot.sh:
# S52_HOME_CONN=my-home-wifi-profile

# Optional autoconnect priorities (hotspot wins when both are in range):
# S52_HOTSPOT_PRIORITY=100
# S52_HOME_PRIORITY=10

# Hotspot SSID (optional; script prompts if unset):
# S52_HOTSPOT_SSID=MyPhoneHotspot
