<?xml version="1.0"?>
<!--
  labwc config for the S52 kiosk session.

  windowRule: the react-carplay AppImage is launched at boot but should be
  invisible until the user taps `+` on the clock. Iconify-on-first-map keeps
  it warm without ever flashing the Electron loading screen at the user.

  IMPORTANT — do NOT set skipTaskbar / skipWindowSwitcher / ignoreFocusRequest:
  labwc translates them into zwlr_foreign_toplevel_handle_v1 state bits, and
  wlrctl (which we use to flip CarPlay in/out) then refuses to act on the
  handle. Iconify alone is enough to prevent focus-steal.
-->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <theme><cornerRadius>0</cornerRadius></theme>
  <focus><followMouse>no</followMouse></focus>
  <!--
    Boot cursor hide: labwc paints its default xcursor at screen centre from
    startup until the first input event — the React app's `cursor: none`
    (src/global.css) only applies once the pointer is over Chromium's surface,
    so the arrow sat on the clock face after every boot. labwc (>= 0.8.x, Pi OS
    ships 0.8.4) only exposes HideCursor as a keybind action, so autostart
    fires this bind via wtype right after launch. wlroots shows the cursor
    again on real pointer motion, so a bench USB mouse works the moment it
    moves — no config flip needed. WarpCursor parks the pointer in the corner
    as belt-and-braces in case a client re-arms the cursor image later.
    <default/> keeps labwc's stock keybinds (A-Tab etc.) for bench keyboards.
  -->
  <keyboard>
    <default />
    <keybind key="A-W-h">
      <action name="HideCursor" />
      <action name="WarpCursor" x="-1" y="-1" />
    </keybind>
  </keyboard>
  <!--
    Touch: send real touch events to Chromium (car UI is touch-native). Pi OS
    desktop defaults mouseEmulation=yes so file-manager double-click works; on a
    kiosk with a Waveshare USB panel + bench USB mouse that can leave a visible
    compositor cursor stuck at the last touch point while REL motion from the
    physical mouse is ignored. Explicit no here overrides Pi OS if labwc merges
    system defaults, and documents the intended car/bench split.
  -->
  <touch deviceName="" mouseEmulation="no" />
  <!-- Ensure both the panel (touch) and bench USB mouse (non-touch) deliver
       events to the compositor cursor. -->
  <libinput>
    <device category="touch">
      <sendEventsMode>yes</sendEventsMode>
    </device>
    <device category="non-touch">
      <sendEventsMode>yes</sendEventsMode>
    </device>
  </libinput>
  <windowRules>
    <!--
      Iconify the react-carplay AppImage as soon as labwc maps it (cold-boot
      keepalive trick). serverDecoration="no" suppresses labwc's white SSD
      titlebar frame so the splash → kiosk transition stays continuous.
    -->
    <windowRule identifier="react-carplay" serverDecoration="no">
      <action name="Iconify"/>
    </windowRule>
    <windowRule identifier="dev.f-io.livi" serverDecoration="no">
      <action name="Iconify"/>
    </windowRule>
  </windowRules>
</openbox_config>
