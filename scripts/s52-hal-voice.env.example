# Copy to ~/.config/s52-hal-voice.env on the Pi (same user as the kiosk).
# Sourced by s52-hal-voice.service before starting the sidecar.

# whisper.cpp model size (downloaded by pywhispercpp on first run — needs
# internet once). tiny.en is faster/lighter; base.en is more accurate.
# See https://github.com/ggml-org/whisper.cpp/blob/master/models/README.md
#export S52_HAL_WHISPER_MODEL=base.en

# VAD strictness 0-3 (webrtcvad). Higher = less sensitive to background road
# noise, but may clip soft speech. Start at 2, raise to 3 if HAL keeps
# "hearing" engine/road noise as speech.
#export S52_HAL_VAD_LEVEL=2

# WebSocket the kiosk UI connects to (must match VITE_HAL_WS_URL, default
# ws://127.0.0.1:8765 — only change both together).
#export S52_HAL_WS_HOST=127.0.0.1
#export S52_HAL_WS_PORT=8765

# Mirrors s52-carplay-audio.env.example — same USB DAC plays the refusal
# line. Get the exact name from `pactl list sinks short`.
#export PULSE_SINK=alsa_output.usb-Generic_USB_Audio-00.analog-stereo

# Mic input — same USB capture device used by node-carplay/Siri checks.
# `pactl list sources short` for the name, or leave unset for the system
# default input device.
#export PULSE_SOURCE=alsa_input.usb-Generic_USB_Audio-00.analog-stereo

# Override the refusal line text (still spoken with the stock espeak-ng
# voice below — swap in a trained HAL voice model later without touching
# this file).
#export S52_HAL_REFUSAL_TEXT="I'm sorry, Dave. I'm afraid I can't do that."
