# HAL voice sidecar tuning — copy to ~/.config/s52-hal-voice.env on the Pi.
# Mic is auto-detected at runtime (same heuristics as pi-audio-usb-default.sh).
# Secrets (ANTHROPIC_API_KEY) live in ~/.config/hal.env, not here.

# whisper.cpp model size (downloaded by pywhispercpp on first run — needs
# internet once). tiny.en is faster/lighter; base.en is more accurate.
# See https://github.com/ggml-org/whisper.cpp/blob/master/models/README.md
#export S52_HAL_WHISPER_MODEL=tiny.en

# VAD strictness 0-3 (webrtcvad). Higher = less sensitive to ambient noise,
# but may clip soft speech. Default 3 — lower to 2 if HAL misses quiet speech.
#export S52_HAL_VAD_LEVEL=3
# Minimum captured speech (ms) before whisper runs; filters clicks/pops.
#export S52_HAL_MIN_UTTERANCE_MS=450
# Trailing silence (ms) that ends an utterance. Raise if phrases get cut off.
#export S52_HAL_SILENCE_END_MS=1200

# WebSocket the kiosk UI connects to (must match VITE_HAL_WS_URL, default
# ws://127.0.0.1:8765 — only change both together).
#export S52_HAL_WS_HOST=127.0.0.1
#export S52_HAL_WS_PORT=8765

# Claude Haiku brain. Model id, reply length cap, and request timeout (s).
#export S52_HAL_LLM_MODEL=claude-haiku-4-5
#export S52_HAL_LLM_MAX_TOKENS=256
#export S52_HAL_LLM_TIMEOUT=20
# Spoken when the network/API is unreachable (cloud-only: no command fallback).
#export S52_HAL_ERROR_TEXT="I'm sorry. I can't reach my higher functions right now."

# HAL 9000 Piper voice. Downloaded on first run to ~/.local/share/piper/.
# Override the filename or source URLs only if you swap voices.
#export S52_HAL_PIPER_MODEL=hal9000.onnx
#export S52_HAL_PIPER_MODEL_URL=https://huggingface.co/campwill/HAL-9000-Piper-TTS/resolve/main/hal.onnx
#export S52_HAL_PIPER_CONFIG_URL=https://huggingface.co/campwill/HAL-9000-Piper-TTS/resolve/main/hal.onnx.json

# TTS speaker output (Pulse sink name from `pactl list sinks short`).
# Usually leave unset: in-car uses ~/.config/s52-carplay-audio.env PULSE_SINK
# (C-Media DAC); at bench HAL auto-picks HDMI and never the USB mic jack.
#export S52_HAL_PULSE_SINK=alsa_output.platform-107c701400.hdmi.pro-output-0
