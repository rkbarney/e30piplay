# Copy to ~/.config/s52-carplay-audio.env on the Pi (same user as labwc / kiosk).
# Do not edit on your Mac for runtime — this file is read on the Pi only.
#
# Labwc autostart sources this file before starting react-carplay so Electron
# picks the right output (USB DAC) instead of HDMI or a silent default.
#
# ALSA-only Pi OS Lite (no pactl): set the card *name* from `aplay -l` (e.g. "Audio").
# Autostart unmutes "Extension Unit" + maxes PCM before each react-carplay start.
#export ALSA_CARD=Audio
#
# Optional override if your card is not named Audio:
#export S52_USB_ALSA_CARD=Device
#
# List sinks (PipeWire / Desktop Pi OS):
#   wpctl status
#   pactl list sinks short
#
# Set system default (affects all apps; often enough by itself):
#   wpctl set-default <id>
#
# PipeWire + pulseaudio-utils: get exact name from `pactl list sinks short` column 2,
# or from `wpctl inspect <id>` → node.name (run scripts/pi-audio-usb-default.sh on the Pi).
#export PULSE_SINK=alsa_output.usb-Generic_USB_Audio-00.analog-stereo
#
# Microphone (3.5mm into a USB adapter that has mic / line *input*): setup script sets
# default capture + PULSE_SOURCE when PipeWire lists a USB source. Check names with:
#   pactl list sources short
#export PULSE_SOURCE=alsa_input.usb-Generic_USB_Audio-00.analog-stereo
#
# Raspberry Pi 5 has no native 3.5mm jack — the mic must use a USB gadget that exposes
# capture in `arecord -l`. A line-only USB→3.5mm DAC cannot accept a separate TRS mic.
#
# One-time after mixer changes: sudo alsactl store
