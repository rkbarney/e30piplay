# Spotify control API secrets/config — copy to ~/.config/s52-spotify.env on
# the Pi and fill in. This file (the real ~/.config/s52-spotify.env) never
# belongs in the repo.
#
#   cp scripts/s52-spotify.env.example ~/.config/s52-spotify.env
#   chmod 600 ~/.config/s52-spotify.env
#   $EDITOR ~/.config/s52-spotify.env
#
# Loaded by spotify-server.cjs via systemd EnvironmentFile — no "export",
# plain KEY=VALUE lines only.

# Create an app at https://developer.spotify.com/dashboard (no secret needed
# — this is a PKCE/public-client flow) and put its Client ID here. Register
# the redirect URI below as that app's exact Redirect URI.
SPOTIFY_CLIENT_ID=

# Public HTTPS bouncer page that forwards the phone's browser to this Pi's
# /spotify-callback over the LAN/hotspot after Spotify's login screen
# redirects back (Spotify requires HTTPS here; the Pi has none on its own).
#SPOTIFY_REDIRECT_URI=https://richardbarney.com/spotify-callback/

# Name shown on phones and in Spotify Connect — also what spotify-server
# matches against /me/player/devices to target playback. Must match
# LIBRESPOT_NAME in /etc/raspotify/conf (setup.sh sets both from
# S52_SPOTIFY_DEVICE_NAME, default "S52 E30" — only override here if you
# changed raspotify's name by hand).
#SPOTIFY_DEVICE_NAME=S52 E30
