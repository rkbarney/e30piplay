# Docker dev (Mac) — copy to repo-root .env and set your Spotify app Client ID.
#   cp .env.example .env
#
# Docker: SPOTIFY_REDIRECT_URI is defaulted by docker-compose.yml to
#   http://127.0.0.1:8080/spotify-callback — do not set it here unless
#   you need a non-default loopback URI. Register that URI in the Spotify
#   Developer Dashboard, then `docker compose up --build` and open
#   http://127.0.0.1:8080
#
# Pi: use ~/.config/s52-spotify.env instead (see scripts/s52-spotify.env.example).

SPOTIFY_CLIENT_ID=
